# ===============================================
# Rabiora E-Commerce Environment Variables
# ===============================================

# 1. MongoDB Database Connection
# Provide your MongoDB Atlas or local MongoDB connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rabiora?retryWrites=true&w=majority

# 2. Server & Authentication
PORT=3000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# 3. CORS & Separated Frontend Domains
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

# 4. Frontend Environment Variables (Client)
# When frontend is deployed separately from backend, set the backend URL:
# e.g., VITE_API_BASE_URL=https://your-backend.vercel.app
VITE_API_BASE_URL=

# 5. Production Persistent Image Storage (Cloudinary)
# Official Cloudinary Node.js SDK credentials for persistent product uploads:
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
