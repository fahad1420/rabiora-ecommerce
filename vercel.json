{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "{server,shared,data}/**",
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api|uploads|assets|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
